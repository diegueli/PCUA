{
  "expo": {
    "name": "Poker Admin",
    "slug": "pcua-poker-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.pcua.pokeradmin"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pcua.pokeradmin"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para las fotos de jugadores.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar fotos de jugadores."
        }
      ]
    ]
  }
}
